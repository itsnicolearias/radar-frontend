# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================
# Dependencies
# ============================================
# Ignore node_modules in all apps and packages
**/node_modules
node_modules/
.pnp
.pnp.js

# ============================================
# Monorepo & Turborepo
# ============================================
.turbo
.cache

# ============================================
# Next.js (Web App)
# ============================================
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ============================================
# Expo & React Native (Mobile App)
# ============================================
# Expo
.expo
.expo-shared
__generated__

# Metro bundler cache
.metro-health-check*

# EAS (Expo Application Services)
eas.json

# Native builds
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Web build output
web-build/

# ============================================
# Build Outputs
# ============================================
dist/
build/
*.log

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# Debug & Logs
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ============================================
# Testing
# ============================================
coverage/
.nyc_output

# ============================================
# IDEs & Editors
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~

# ============================================
# Vercel
# ============================================
.vercel

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
.tmp/
.temp/

apps/**/node_modules/
# Ignore only node_modules inside packages
packages/**/node_modules/
# Keep other content in packages tracked by default
!packages/**
!packages//node_modules/
packages/**