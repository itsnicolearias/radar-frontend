{
  "name": "radar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:mobile": "cd apps/expo && npm run build",
    "build:web": "cd apps/next && npm run build",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "lint": "npm run lint --workspaces",
    "mobile": "cd apps/expo && npm run start",
    "web": "cd apps/next && npm run dev"
  },
  "overrides": {
    "lucide-react": "0.548.0",
    "react": "19.2.3",
    "react-native": "0.81.5",
    "react-native-reanimated": "4.0.2",
    "react-native-renderer": "19.2.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-worklets": "0.4.1"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
    "@expo/dom-webview": "latest",
    "@expo/metro-runtime": "latest",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/drawer": "latest",
    "@testing-library/react-native": "latest",
    "axios": "1.12.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "54.0.32",
    "expo-constants": "latest",
    "expo-image-picker": "17.0.10",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "latest",
    "expo-location": "19.0.8",
    "expo-module-scripts": "^5.0.8",
    "expo-notifications": "0.32.16",
    "expo-router": "6.0.22",
    "expo-status-bar": "3.0.9",
    "framer-motion": "^12.23.24",
    "immer": "latest",
    "jimp-compact": "0.16.1-2",
    "lightningcss": "^1.31.1",
    "lucide-react": "0.548.0",
    "lucide-react-native": "^0.553.0",
    "moti": "^0.30.0",
    "next": "^16.0.8",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "7.71.1",
