{
  "name": "radar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "cd apps/next && npm run dev",
    "mobile": "cd apps/expo && npm run start",
    "build:web": "cd apps/next && npm run build",
    "build:mobile": "cd apps/expo && npm run build",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.16",
    "typescript": "^5"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "axios": "1.12.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo-linear-gradient": "^15.0.7",
    "framer-motion": "^12.23.24",
    "lucide-react": "0.548.0",
    "lucide-react-native": "^0.553.0",
    "moti": "^0.30.0",
    "next": "^16.0.8",
    "next-themes": "0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "overrides": {
    "react-native-safe-area-context": "^4.12.0",
    "lucide-react": "0.548.0"
  }
}
