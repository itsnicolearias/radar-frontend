{
  "name": "radar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "cd apps/next && npm run dev",
    "mobile": "cd apps/expo && npm start",
    "build:web": "cd apps/next && npm run build",
    "build:mobile": "cd apps/expo && npm run build",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "tailwindcss": "4.1.16",
    "postcss": "8.5.6"
  },
  "dependencies": {
    "next-themes": "0.4.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-label": "2.1.7",
    "axios": "1.12.2",
    "zustand": "5.0.8",
    "zod": "4.1.12",
    "tw-animate-css": "1.4.0",
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.548.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7"
  }
}
