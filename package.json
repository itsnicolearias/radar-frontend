    "react-native-webview": "latest",
    "react-native-windows": "latest",
    "react-native-worklets": "latest",
    "react-server-dom-webpack": "latest",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "use-sync-external-store": "latest",
    "zod": "4.1.12",
    "zustand": "5.0.8"
