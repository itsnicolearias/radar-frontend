{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@radar/api": [
        "../../packages/api"
      ],
      "@radar/config": [
        "../../packages/config"
      ],
      "@radar/features": [
        "../../packages/features"
      ],
      "@radar/types": [
        "../../packages/types"
      ],
      "@radar/ui": [
        "../../packages/ui"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
