{
  "expo": {
    "name": "Radar",
    "slug": "radar-app",
    "scheme": "radar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/radar-app-icon-1024x1024.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/radar-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "experiments": {
      "reactCanary": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itsnicolearias.radar.app"
    },
    "android": {
      "icon": "./assets/radar-app-icon-1024x1024.png",
      "package": "com.radar.app"
    },
    "web": {
      "favicon": "./assets/radar-app-icon-64x64.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "331aed76-dc01-4191-8aa6-f69fb298f553"
      }
    }
  }
}
