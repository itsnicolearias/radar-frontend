{
  "expo": {
    "name": "Radar",
    "slug": "radar-app",
    "scheme": "radar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/abrir-perfil-radar.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/abrir-perfil-radar.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
     "experiments": {
      "reactCanary": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.radar.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/abrir-perfil-radar.jpg",
        "backgroundColor": "#0A1628"
      },
      "package": "com.radar.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "331aed76-dc01-4191-8aa6-f69fb298f553"
      }
    
    }
  }
}
